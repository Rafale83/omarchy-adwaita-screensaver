#!/bin/bash
# Wait for the real fullscreen grid, then run ttfx on that canvas.
# Packaged omarchy-screensaver can start ttfx at 80x24 if resize is slow.

screensaver_in_focus() {
  hyprctl activewindow -j | jq -e '.class == "org.omarchy.screensaver"' >/dev/null 2>&1
}

exit_screensaver() {
  printf '\033[?1003l\033[?1006l\033[=0;1u'
  hyprctl eval 'hl.config({ cursor = { invisible = false } })' &>/dev/null || hyprctl keyword cursor:invisible false &>/dev/null || true
  pkill -x ttfx 2>/dev/null
  ps -C foot -o pid=,args= | awk '/screensaver.ini/ {print $1}' | while read -r p; do kill "$p" 2>/dev/null; done
  exit 0
}

trap exit_screensaver SIGINT SIGTERM SIGHUP SIGQUIT
printf '\033]11;rgb:00/00/00\007'
hyprctl eval 'hl.config({ cursor = { invisible = true } })' &>/dev/null || hyprctl keyword cursor:invisible true &>/dev/null

# Wake on any input, not just keys that type a character. Mouse tracking
# (any-motion + SGR) turns moves, clicks, and wheel into bytes on stdin, and the
# kitty keyboard protocol's "report all keys" flag does the same for a lone
# Shift, Ctrl, or Alt. ttfx never touches these modes, so setting them once holds.
printf '\033[?1003h\033[?1006h\033[=9;1u'

tty=$(tty 2>/dev/null)

rows=0
cols=0
deadline=$((SECONDS + 5))
while ((SECONDS < deadline)); do
  size=$(stty size 2>/dev/null) || size=""
  rows=${size% *}
  cols=${size#* }
  if [[ ${cols:-0} -gt 200 && ${rows:-0} -gt 60 ]]; then
    break
  fi
  sleep 0.03
done

if [[ ${cols:-0} -lt 80 ]]; then
  cols=80
  rows=24
fi

branding="$HOME/.config/omarchy/branding/screensaver.txt"
frame_rate="${SS_FRAME_RATE:-260}"
settings="$HOME/.config/omarchy/screensaver-overlay/settings.json"
exclude_args=()
color_args=()
if [[ -f $settings ]]; then
  mapfile -t meta < <(python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); print(d.get("source") or "text"); print(d.get("fortuneLang") or "en"); print(d.get("font") or "Adwaita Mono"); print(d.get("artworkCols") or 300); print("\n".join(d.get("excludeEffects") or []))' "$settings")
  source="${meta[0]:-text}"
  fortune_lang="${meta[1]:-en}"
  font="${meta[2]:-Adwaita Mono}"
  art_cols="${meta[3]:-300}"
  excludes=("${meta[@]:4}")
  if [[ $source == photo ]]; then
    # Keep the photo's ANSI truecolor; effect palettes would flatten it to 2 tones.
    color_args=(--existing-color-handling always)
  fi
  if ((${#excludes[@]})); then
    exclude_args=(--exclude-effects "${excludes[@]}")
  fi
fi

overlay="$HOME/.config/omarchy/screensaver-overlay"

# A new quote before every effect cycle, so the screensaver is not one joke on
# repeat. Failures are silent: the previous mosaic stays on screen.
redraw_fortune() {
  [[ $source == fortune ]] || return 0
  local lines
  mapfile -t lines < <(python3 "$overlay/pick-fortune.py" --lang "$fortune_lang" 2>/dev/null)
  ((${#lines[@]})) || return 0
  python3 "$overlay/generate-branding.py" --font "$font" --cols "${art_cols:-300}" "${lines[@]}" >/dev/null 2>&1 || true
}

while true; do
  redraw_fortune

  /usr/bin/ttfx -i "$branding" \
    --frame-rate "$frame_rate" \
    --canvas-width "$cols" --canvas-height "$rows" \
    --reuse-canvas --anchor-canvas c --anchor-text c \
    "${color_args[@]}" \
    --random-effect "${exclude_args[@]}" --no-eol --no-restore-cursor &

  while pgrep -t "${tty#/dev/}" -x ttfx >/dev/null; do
    if read -rsn1 -t 1 || ! screensaver_in_focus; then
      exit_screensaver
    fi
  done
done
